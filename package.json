{
  "name": "folio-archive",
  "version": "0.4.13",
  "private": true,
  "description": "拾页 · 在线文档离线归档助手",
  "main": "dist-electron/main.cjs",
  "author": "Folio",
  "license": "MIT",
  "homepage": "https://github.com/xyra17/folio-archive#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xyra17/folio-archive.git"
  },
  "bugs": {
    "url": "https://github.com/xyra17/folio-archive/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "format": "prettier --write src electron shared tests scripts/*.mjs *.json *.ts *.html",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:sites": "npm run build && node scripts/sites.mjs",
    "test:pipeline": "npm run build && node scripts/pipeline.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.1.2",
    "docx": "^9.15.0",
    "electron-updater": "^6.8.0",
    "jszip": "^3.10.1",
    "katex": "^0.19.1",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.18.1",
    "sql.js": "^1.15.2",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/sql.js": "^1.4.9",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.63.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "app.folio.archive",
    "productName": "拾页",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "拾页 ${version}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
